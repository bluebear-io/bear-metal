# Required trusted deployment configuration module (.js, .mjs, .ts, or .mts).
BEAR_METAL_CONFIG_FILE=/config/bear-metal.config.mts

# Example inputs for the optional agentIntegrations entries in that module.
# These names are not read directly by Bear Metal; the configuration module chooses its secret sources.
AGENT_GITHUB_APP_ID=
AGENT_GITHUB_INSTALLATION_ID=
AGENT_GITHUB_APP_PRIVATE_KEY=
AGENT_LINEAR_CLIENT_ID=
AGENT_LINEAR_CLIENT_SECRET=
AGENT_SLACK_BOT_TOKEN=

# Manager infrastructure
WORKER_CONCURRENCY=5
POLL_INTERVAL_MS=60000
TASK_HEARTBEAT_INTERVAL_MS=30000
TASK_STALE_AFTER_MS=300000
TASK_MAX_RECLAIMS=3
BEAR_METAL_WORKSPACE_DIR=
BACKEND_PORT=3100
API_ONLY=false
LOG_LEVEL=info
LOG_PRETTY=false
TEST_TICKET_ID=

# AWS SDK / embedded Bedrock client inputs. Bear Metal does not interpret these.
AWS_REGION=us-east-1
AWS_BEARER_TOKEN_BEDROCK=
AWS_BEDROCK_FORCE_CACHE=

# UI build/development
APP_VERSION=dev
BACKEND_URL=http://localhost:3100
